Description: fix module build for kernel 3.11
Author: Milos_SD
Origin: other, https://devtalk.nvidia.com/default/topic/549532/linux/linux-3-10-solved-3-11-solved-incompatibility-in-function-lsquo-nv_i2c_del_adapter-rsquo-error/2/

--- a/nv-linux.h
+++ b/nv-linux.h
@@ -1465,4 +1465,10 @@
 #include "nv-linux-ext.h"
 #endif
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(3,11,0)
+#define NV_NUM_PHYSPAGES                get_num_physpages()
+#else
+#define NV_NUM_PHYSPAGES                num_physpages
+#endif
+
 #endif  /* _NV_LINUX_H_ */
--- a/os-interface.c
+++ b/os-interface.c
@@ -292,7 +292,7 @@
 
 NvU64 NV_API_CALL os_get_system_memory_size(void)
 {
-    return ((NvU64) num_physpages * PAGE_SIZE) / RM_PAGE_SIZE;
+    return ((NvU64) NV_NUM_PHYSPAGES * PAGE_SIZE) / RM_PAGE_SIZE;
 }
 
