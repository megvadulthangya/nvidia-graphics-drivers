From 48e7331810f417a1f20f02d5bd14bd0e38fa3bbb Mon Sep 17 00:00:00 2001
From: Andreas Beckmann <anbe@debian.org>
Date: Sat, 26 Sep 2026 00:01:32 +0200
Subject: [PATCH] backport screen_info changes from 450.51

---
 nv-linux.h     | 6 ++++++
 nv.c           | 2 +-
 os-interface.c | 2 +-
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/nv-linux.h b/nv-linux.h
index ed8f9b5d..fa412a1d 100644
--- a/nv-linux.h
+++ b/nv-linux.h
@@ -2273,4 +2273,10 @@ static inline void nv_vm_flags_clear(struct vm_area_struct *vma, vm_flags_t flag
 #endif
 }
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+#define NV_IS_EXPORT_SYMBOL_PRESENT_screen_info 0
+#else
+#define NV_IS_EXPORT_SYMBOL_PRESENT_screen_info 1
+#endif
+
 #endif  /* _NV_LINUX_H_ */
diff --git a/nv.c b/nv.c
index 35307eec..2b6ffbf3 100644
--- a/nv.c
+++ b/nv.c
@@ -1463,7 +1463,7 @@ nvidia_open(
         }
 #endif
 #if !defined(NV_VMWARE) && \
-  (defined(NVCPU_X86) || defined(NVCPU_X86_64))
+  (defined(NVCPU_X86) || defined(NVCPU_X86_64)) && NV_IS_EXPORT_SYMBOL_PRESENT_screen_info
         if (nv->primary_vga && (screen_info.orig_video_isVGA != 0x01))
         {
             if (!nv_fbdev_failure_detected)
diff --git a/os-interface.c b/os-interface.c
index 640e89fb..a670d328 100644
--- a/os-interface.c
+++ b/os-interface.c
@@ -1145,7 +1145,7 @@ RM_STATUS NV_API_CALL os_get_efi_screen_info(
     NvU32 *pPitch
 )
 {
-#if !defined(NV_VMWARE) && (defined(NVCPU_X86) || defined(NVCPU_X86_64))
+#if !defined(NV_VMWARE) && (defined(NVCPU_X86) || defined(NVCPU_X86_64)) && NV_IS_EXPORT_SYMBOL_PRESENT_screen_info
     if (NV_EFI_ENABLED())
     {
         *pPhysicalAddress = screen_info.lfb_base;
-- 
2.39.5

