#! /bin/sh
# preinst script for nvidia-glx
#
# see: dh_installdeb(1)

set -e

case "$1" in
    install|upgrade)


	if [ ! -d /usr/lib/nvidia ]; then
		mkdir -p /usr/lib/nvidia || true
	fi
	if [ ! -d /usr/X11R6/lib/nvidia ]; then
		mkdir -p /usr/X11R6/lib/nvidia || true
	fi


	dpkg-divert --add --rename --package nvidia-glx-legacy-71xx-dev --divert /usr/lib/nvidia/libGL.so.xlibmesa /usr/lib/libGL.so > /dev/null
#	dpkg-divert --add --rename --package nvidia-glx-legacy-dev --divert /usr/X11R6/lib/nvidia/libGL.so.xlibmesa /usr/X11R6/lib/libGL.so > /dev/null
#        rm /usr/lib/libGL.so || true
#	rm /usr/X11R6/lib/libGL.so || true
	
#	ln -s /usr/lib/libGL.so.#VERSION# /usr/lib/libGL.so || true
	
	
	dpkg-divert --add --rename --package nvidia-glx-legacy-71xx-dev --divert /usr/lib/nvidia/libGL.a.xlibmesa /usr/lib/libGL.a > /dev/null
#	dpkg-divert --add --rename --package nvidia-glx-legacy-dev --divert /usr/X11R6/lib/nvidia/libGL.a.xlibmesa /usr/X11R6/lib/libGL.a > /dev/null

#	dpkg-divert --add --rename --package nvidia-glx-legacy-dev --divert /usr/share/nvidia-glx/diversions/gl.h /usr/include/GL/gl.h > /dev/null
#	dpkg-divert --add --rename --package nvidia-glx-legacy-dev --divert /usr/share/nvidia-glx/diversions/glx.h /usr/include/GL/glx.h > /dev/null
#	dpkg-divert --add --rename --package nvidia-glx-legacy-dev --divert /usr/share/nvidia-glx/diversions/glxtokens.h /usr/include/GL/glxtokens.h > /dev/null

#	dpkg-divert --add --rename --package nvidia-glx-legacy-dev --divert /usr/share/nvidia-glx/diversions-X11R6/gl.h /usr/X11R6/include/GL/gl.h > /dev/null
#	dpkg-divert --add --rename --package nvidia-glx-legacy-dev --divert /usr/share/nvidia-glx/diversions-X11R6/glx.h /usr/X11R6/include/GL/glx.h > /dev/null
#	dpkg-divert --add --rename --package nvidia-glx-legacy-dev --divert /usr/share/nvidia-glx/diversions-X11R6/glxtokens.h /usr/X11R6/include/GL/glxtokens.h > /dev/null

  ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 0
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
