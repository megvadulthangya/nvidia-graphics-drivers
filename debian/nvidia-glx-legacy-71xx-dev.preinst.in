#! /bin/sh
# preinst script for nvidia-glx
#
# see: dh_installdeb(1)

set -e

case "$1" in
    install|upgrade)

	if [ ! -d /usr/lib/nvidia ]; then
		mkdir -p /usr/lib/nvidia || true
	fi
	if [ ! -d /usr/X11R6/lib/nvidia ]; then
		mkdir -p /usr/X11R6/lib/nvidia || true
	fi

	dpkg-divert --add --rename --package nvidia-glx-legacy-71xx-dev --divert /usr/lib/nvidia/libGL.a.xlibmesa /usr/lib/libGL.a > /dev/null
  ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 0
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
