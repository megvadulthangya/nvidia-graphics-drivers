#! /bin/sh
# preinst script for nvidia-glx-legacy-96xx
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <new-preinst> `install'
#        * <new-preinst> `install' <old-version>
#        * <new-preinst> `upgrade' <old-version>
#        * <old-preinst> `abort-upgrade' <new-version>
#
# For details see /usr/share/doc/packaging-manual/

case "$1" in
    install|upgrade)
	
	# clean up from old diversions
	
        if dpkg-divert --list /usr/X11R6/lib/libGL.so.1 | grep 'nvidia-glx-legacy-96xx' > /dev/null ; then
		dpkg-divert --remove --rename --package nvidia-glx-legacy-96xx --divert /usr/X11R6/lib/nvidia/libGL.so.1.xlibmesa /usr/X11R6/lib/libGL.so.1 > /dev/null
	fi
	
	if dpkg-divert --list /usr/X11R6/lib/libGL.so.1.2 | grep 'nvidia-glx-legacy-96xx' > /dev/null ; then
		dpkg-divert --remove --rename --package nvidia-glx-legacy-96xx --divert /usr/X11R6/lib/nvidia/libGL.so.1.2.xlibmesa /usr/X11R6/lib/libGL.so.1.2 > /dev/null
	fi
	if dpkg-divert --list /usr/X11R6/lib/modules/extensions/libGLcore.a | grep 'nvidia-glx-legacy-96xx' > /dev/null ; then
 		dpkg-divert --remove --rename --package nvidia-glx-legacy-96xx --divert /usr/X11R6/lib/nvidia/libGLcore.a.xlibmesa /usr/X11R6/lib/modules/extensions/libGLcore.a > /dev/null
  	fi
	if dpkg-divert --list /usr/X11R6/lib/modules/extensions/libglx.a | grep 'nvidia-glx-legacy-96xx' > /dev/null ; then
		dpkg-divert --remove --rename --package nvidia-glx-legacy-96xx --divert /usr/X11R6/lib/nvidia/libglx.a.xlibmesa /usr/X11R6/lib/modules/extensions/libglx.a > /dev/null
	fi
	if dpkg-divert --list /usr/X11R6/lib/modules/extensions/libglx.so | grep 'nvidia-glx-legacy-96xx' > /dev/null ; then
		dpkg-divert --remove --rename --package nvidia-glx-legacy-96xx --divert /usr/X11R6/lib/nvidia/libglx.so.xlibmesa /usr/X11R6/lib/modules/extensions/libglx.so > /dev/null
        fi

        # make sure these diversions don't exist anymore
        if dpkg-divert --list /usr/lib/libGL.so | grep 'nvidia-glx-legacy-96xx-dev' > /dev/null ; then
                dpkg-divert --remove --rename --package nvidia-glx-legacy-96xx-dev --divert /usr/lib/nvidia/libGL.so.xlibmesa /usr/lib/libGL.so > /dev/null
        fi
        if dpkg-divert --list /usr/lib/libGL.a | grep 'nvidia-glx-legacy-96xx-dev' > /dev/null ; then
                dpkg-divert --remove --rename --package nvidia-glx-legacy-96xx-dev --divert /usr/lib/nvidia/libGL.a.xlibmesa /usr/lib/libGL.a > /dev/null
        fi
        if dpkg-divert --list /usr/X11R6/lib/libGL.so | grep 'nvidia-glx-legacy-96xx-dev' > /dev/null ; then
               dpkg-divert --remove --rename --package nvidia-glx-legacy-96xx-dev --divert /usr/X11R6/lib/nvidia/libGL.a.xlibmesa /usr/X11R6/lib/libGL.a > /dev/null
        fi
	# create new diversion directories
	if [ ! -d /usr/lib/nvidia ]; then
		mkdir -p /usr/lib/nvidia || true
	fi

	# make new diversions
	dpkg-divert --add --rename --package nvidia-glx-legacy-96xx --divert /usr/lib/nvidia/libGL.so.1.xlibmesa /usr/lib/libGL.so.1 > /dev/null
	dpkg-divert --add --rename --package nvidia-glx-legacy-96xx --divert /usr/lib/nvidia/libGL.so.1.2.xlibmesa /usr/lib/libGL.so.1.2 > /dev/null

	dpkg-divert --add --rename --package nvidia-glx-legacy-96xx --divert /usr/lib/nvidia/libGLcore.a.xlibmesa /usr/lib/xorg/modules/extensions/libGLcore.a > /dev/null
	dpkg-divert --add --rename --package nvidia-glx-legacy-96xx --divert /usr/lib/nvidia/libglx.a.xlibmesa /usr/lib/xorg/modules/extensions/libglx.a > /dev/null
	dpkg-divert --add --rename --package nvidia-glx-legacy-96xx --divert /usr/lib/nvidia/libglx.so.xlibmesa /usr/lib/xorg/modules/extensions/libglx.so > /dev/null	

	dpkg-divert --add --rename --package nvidia-glx-legacy-96xx --divert /usr/lib/nvidia/libGL.so.xlibmesa /usr/lib/libGL.so > /dev/null
	
	;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 0
    ;;
esac



# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
